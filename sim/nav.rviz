# One config for all ten runs.  RViz silently ignores a topic nobody publishes,
# so every planner's and every controller's own visualisation can live here at
# once rather than in ten near-identical files.
#
# No separate /map display: the global costmap already carries the warehouse
# through its static_layer, and a second grid at the same z only z-fights.
Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded: ~
    Width: 300
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Color: 96; 100; 108
      Cell Size: 1
      Plane Cell Count: 60
    - Class: rviz_default_plugins/Map
      Name: GlobalCostmap
      Enabled: true
      Topic:
        Value: /global_costmap/costmap
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Color Scheme: costmap
      Alpha: 0.55
      Draw Behind: true
    - Class: rviz_default_plugins/Map
      Name: LocalCostmap
      Enabled: true
      Topic:
        Value: /local_costmap/costmap
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Color Scheme: costmap
      Alpha: 0.85
      Draw Behind: false
    - Class: rviz_default_plugins/RobotModel
      Name: Robot
      Enabled: true
      Description Topic:
        Value: /robot_description
        Durability Policy: Transient Local
      Alpha: 1
    - Class: rviz_default_plugins/LaserScan
      Name: Scan
      Enabled: true
      Topic:
        Value: /scan
        Reliability Policy: Best Effort
      Size (m): 0.05
      Color: 255; 214; 92
      Color Transformer: FlatColor
      Style: Points
    # --- what each planner searched, drawn under the plan it produced -------
    - Class: rviz_default_plugins/MarkerArray
      Name: AStarExplored
      Enabled: true
      Topic: {Value: /astar_explored, Reliability Policy: Reliable}
    - Class: rviz_default_plugins/MarkerArray
      Name: ThetaStarExplored
      Enabled: true
      Topic: {Value: /theta_star_explored, Reliability Policy: Reliable}
    - Class: rviz_default_plugins/MarkerArray
      Name: SmacExplored
      Enabled: true
      Topic: {Value: /smac_explored, Reliability Policy: Reliable}
    - Class: rviz_default_plugins/MarkerArray
      Name: RrtTree
      Enabled: true
      Topic: {Value: /rrt_tree, Reliability Policy: Reliable}
    - Class: rviz_default_plugins/MarkerArray
      Name: HybridTree
      Enabled: true
      Topic: {Value: /hybrid_tree, Reliability Policy: Reliable}
    - Class: rviz_default_plugins/MarkerArray
      Name: AStarMarkers
      Enabled: true
      Topic: {Value: /astar_markers, Reliability Policy: Reliable}
    - Class: rviz_default_plugins/MarkerArray
      Name: ThetaStarMarkers
      Enabled: true
      Topic: {Value: /theta_star_markers, Reliability Policy: Reliable}
    - Class: rviz_default_plugins/MarkerArray
      Name: SmacMarkers
      Enabled: true
      Topic: {Value: /smac_markers, Reliability Policy: Reliable}
    # --- what each controller is considering this tick ---------------------
    - Class: rviz_default_plugins/MarkerArray
      Name: DwaRollouts
      Enabled: true
      Topic: {Value: /dwa_trajectories, Reliability Policy: Reliable}
    - Class: rviz_default_plugins/MarkerArray
      Name: MppiRollouts
      Enabled: true
      Topic: {Value: /mppi_trajectories, Reliability Policy: Reliable}
    - Class: rviz_default_plugins/MarkerArray
      Name: TebBand
      Enabled: true
      Topic: {Value: /teb_band, Reliability Policy: Reliable}
    - Class: rviz_default_plugins/MarkerArray
      Name: DwaBest
      Enabled: true
      Topic: {Value: /dwa_best_traj, Reliability Policy: Reliable}
    - Class: rviz_default_plugins/Marker
      Name: PurePursuitLookahead
      Enabled: true
      Topic: {Value: /pure_pursuit_lookahead, Reliability Policy: Reliable}
    - Class: rviz_default_plugins/Marker
      Name: StanleyClosest
      Enabled: true
      Topic: {Value: /stanley_closest_point, Reliability Policy: Reliable}
    - Class: rviz_default_plugins/Marker
      Name: DwaGoal
      Enabled: true
      Topic: {Value: /dwa_goal, Reliability Policy: Reliable}
    # The robot model renders dark and small at this framing -- in a 560 px
    # GIF it is a few pixels of grey against a black floor.  The costmap's own
    # footprint polygon outlines it in white and moves with it, so the robot is
    # findable in a still frame rather than only inferable from the trail.
    - Class: rviz_default_plugins/Polygon
      Name: Footprint
      Enabled: true
      Topic: {Value: /local_costmap/published_footprint, Reliability Policy: Reliable}
      Color: 255; 255; 255
      Alpha: 1
    # --- the plan, and the line the robot actually drove --------------------
    - Class: rviz_default_plugins/Path
      Name: GlobalPlan
      Enabled: true
      Topic: {Value: /plan, Reliability Policy: Reliable}
      Color: 255; 106; 31
      Line Width: 0.07
      Line Style: Billboards
    - Class: rviz_default_plugins/Path
      Name: DrivenPath
      Enabled: true
      Topic: {Value: /driven_path, Reliability Policy: Reliable}
      Color: 80; 230; 160
      Line Width: 0.05
      Line Style: Billboards
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
  Global Options:
    Background Color: 62; 66; 74
    Fixed Frame: map
    Frame Rate: 6
  Tools:
    - Class: rviz_default_plugins/MoveCamera
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 6.5
      Pitch: 1.3
      Yaw: 4.7124
      Focal Point: {X: 1.0, Y: -1.7, Z: 0}
      Name: Current View
    Saved: ~
Window Geometry:
  Hide Left Dock: true
  Hide Right Dock: true
  Displays:
    collapsed: true
  Height: 720
  Width: 1280
  QMainWindow State: ""
